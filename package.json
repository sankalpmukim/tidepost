{
  "name": "tidepost",
  "private": true,
  "version": "0.2.0",
  "description": "Tidepost: a keyboard-first email client for Gmail and Outlook, built like an agent workbench",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build && node -e \"const fs=require('fs');fs.mkdirSync('dist/app',{recursive:true});fs.copyFileSync('dist/index.html','dist/app/index.html');fs.copyFileSync('public/landing.html','dist/index.html')\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "verify": "npm run build && node scripts/verify.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create tidepost",
    "db:migrate:local": "wrangler d1 migrations apply tidepost --local",
    "db:migrate:remote": "wrangler d1 migrations apply tidepost --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "dompurify": "^3.4.17",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "workerd@1.20261110.1": true
  }
}
