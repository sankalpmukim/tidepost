# Tidepost configuration on Cloudflare.
#
# In production these are Worker vars/secrets:
#   npx wrangler secret put TIDEPOST_SECRET        (required)
#   npx wrangler secret put GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   npx wrangler secret put MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET
#   npx wrangler secret put ANTHROPIC_API_KEY      (optional)
# Non-secret vars live in wrangler.jsonc under "vars".
#
# For local development, copy this file to .dev.vars (same KEY=value format,
# picked up by `wrangler dev`):
#   cp .env.example .dev.vars

# Public URL the browser uses. OAuth redirect URIs are built from it:
#   ${APP_URL}/api/auth/google/callback
#   ${APP_URL}/api/auth/microsoft/callback
# In development the Vite server on :5173 proxies /api to wrangler dev on :8787.
APP_URL=http://localhost:5173

# Required: encrypts OAuth tokens at rest (AES-256-GCM). Must be identical
# across deploys or stored tokens become undecryptable.
TIDEPOST_SECRET=

# Gmail: Google Cloud console > APIs & Services > Credentials > OAuth client ID
# (Web application). Enable the Gmail API for the project.
# Scope used: gmail.modify (+ openid email profile).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365: Entra admin center > App registrations > New registration.
# Supported account types: "Any organizational directory and personal Microsoft accounts".
# Platform: Web, redirect URI ${APP_URL}/api/auth/microsoft/callback. Add a client secret.
# Delegated Graph permissions: openid profile email offline_access User.Read Mail.ReadWrite Mail.Send
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Optional: enables AI briefs, reply drafting and plans (otherwise heuristics are used).
ANTHROPIC_API_KEY=
TIDEPOST_AI_MODEL=claude-opus-5-5

# Optional (defaults shown; also settable in wrangler.jsonc)
# TIDEPOST_SYNC_MESSAGES=800   # messages indexed per account
# TIDEPOST_POLL_SECONDS=45
# TIDEPOST_DEMO=1              # set to 0 to hide the demo mailbox
