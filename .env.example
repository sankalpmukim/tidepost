# Copy to .env and fill in. Restart the server after changes.

# Public URL the browser uses. OAuth redirect URIs are built from it:
#   ${APP_URL}/api/auth/google/callback
#   ${APP_URL}/api/auth/microsoft/callback
# In development the Vite server on :5173 proxies /api to the API on :8787.
APP_URL=http://localhost:5173
PORT=8787

# Gmail: Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Enable the Gmail API for the project. Scope used: gmail.modify (+ openid email profile).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365: Entra admin center > App registrations > New registration.
# Supported account types: "Any organizational directory and personal Microsoft accounts".
# Platform: Web, redirect URI ${APP_URL}/api/auth/microsoft/callback. Add a client secret.
# Delegated Graph permissions: openid profile email offline_access User.Read Mail.ReadWrite Mail.Send
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Optional: enables AI briefs, reply drafting and plans (otherwise heuristics are used).
ANTHROPIC_API_KEY=
TIDEPOST_AI_MODEL=claude-opus-5-5

# Required on Vercel (and recommended locally): encrypts OAuth tokens and authorizes Convex.
# TIDEPOST_SECRET=

# Convex (npx convex dev writes CONVEX_URL into .env.local)
# CONVEX_URL=
# TIDEPOST_JWT_PRIVATE_KEY=   # ES256 PKCS8; local fallback is .jwt-private.pem

# Optional
# TIDEPOST_DATA_DIR=.data
# TIDEPOST_SYNC_MESSAGES=800  # messages indexed per account; keep modest for Convex free tier
# TIDEPOST_STORE=memory       # tests/local without Convex; omit in production
# TIDEPOST_POLL_SECONDS=45
# TIDEPOST_DEMO=1            # set to 0 to hide the demo mailbox
